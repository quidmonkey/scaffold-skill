# Pre-push code review and ship config (read by scripts/code-review.sh and
# scripts/ship.sh). Format: key=value, one per line, no quotes.
#
# Any key can be overridden for one run without editing this file:
#   make ship SET='review_model=sonnet;ship_stage=merge'   (or /ship merge review_model=sonnet)
#   CR_REVIEW_MODEL=sonnet git push                          (CR_ + the key in uppercase)
# An empty override means the built-in default. An unknown key fails the run.

# Review agent: claude | custom
review_agent=claude

# Models are set here rather than inherited from the CLI default. Aliases
# (opus, sonnet) move to each new release; a full ID such as claude-opus-5-5
# pins one exactly. A blocked push with auto-fix on runs up to 4 review-agent
# passes and 2 fix passes.

# Model for pass 1, the general review. Finding bugs nobody has named yet is the
# hardest job in the gate: a missed bug is invisible, and a false REQUIRED costs
# a fix and a verification round.
review_model=opus

# Effort for pass 1: low | medium | high | xhigh | max | default (CLI default).
review_effort=high

# Model for pass 2 (spec conformance) and for verifying fixes. Both compare the
# code against a stated doc or finding.
review_spec_model=sonnet

# Effort for pass 2 and fix verification. Same values as review_effort. Set
# explicitly because the CLI default moves between releases, and a level
# doesn't mean the same amount of thinking on every model.
review_spec_effort=medium

# Set to false to disable the pre-push code review entirely.
enabled=true

# Seconds any one agent call (review, verification, or fix) may run before it
# is killed. A timed-out review pass counts as failed, so a hung agent blocks
# the push instead of hanging it forever.
agent_timeout=900

# Required when review_agent=custom. The command receives the review prompt on
# stdin and must print its review to stdout, whose last non-empty line reads
# "VERDICT: PASS" or "VERDICT: FAIL" and is followed by nothing else.
# command=my-agent --headless

# --- Auto-fix -----------------------------------------------------------------

# When true, a failed review hands its REQUIRED findings to a fix agent that
# fixes each one in the working tree or disputes it with evidence, then a
# verification pass checks the fix; fix -> verify loops until nothing is open or
# fix_max_iterations is reached. Both
# review passes' findings go to a single fix agent (no per-issue parallelism —
# coupled fixes and shared root causes need one coherent pass). Fixes are left
# uncommitted; the push stays blocked so you review, commit, and push again.
# On by default so a push keeps looping until it passes. Set to false to skip
# fixing and stop at the first failed review instead.
fix_enabled=true

# Agent used to apply fixes when fix_enabled=true: claude | custom
fix_agent=claude

# Model for the fix pass. The findings it works from already name the file, the
# failure, and the change needed, and a verification pass checks its work.
fix_model=sonnet

# Effort for the fix pass. Same values as review_effort. At low, a fixer is more
# likely to report a fix done without running the checks that exercise it.
fix_effort=medium

# Max fix -> verify rounds before the loop gives up (positive integer).
fix_max_iterations=2

# Required when fix_agent=custom. The command receives the fix prompt (which
# points at the findings) on stdin and must edit the working tree.
# fix_command=my-agent --headless --write

# Max times one ship (scripts/ship.sh) commits an auto-fix and pushes again
# (non-negative integer). No confirmation: the ship's worktree is its own, and
# each re-push runs the full review again. By then the fix_max_iterations loop
# above has already converged the fix, so more than one retry is only needed
# if the fresh commit's full review turns up something new. A plain
# `git push` never commits or retries on its own.
ship_fix_retries=1

# --- Shipping (/ship, make ship) -------------------------------------------------
# ship.sh snapshots the branch, reviews and pushes it from its own worktree
# (../<repo>.ship-<id>), then goes as far as ship_stage. It only ever targets
# develop. Stages are cumulative:
#   push           stop after the push
#   open_pr        open a PR from the snapshot branch into develop
#   merge          also self-approve, arm auto-merge, and wait for the merge
#   verify_deploy  also wait for the dev deploy, check health, run the smoke test
# `make ship-stage STAGE=<stage>` rewrites this line.
ship_stage=open_pr

# Days to keep finished ship logs in .git/ship/; 0 keeps them forever.
ship_log_retention_days=30

# none | desktop (desktop notification on macOS, Windows or Linux when the ship finishes)
ship_notify=none

# CLI used to open/approve/merge the PR: gh | az. Auto-detected from
# `git remote get-url origin` when unset (github.com -> gh, anything else ->
# az). Set explicitly only to override detection.
# pr_host=gh

# Reviewers added to the PR, comma-separated. Empty adds none.
# GitHub: usernames or org/team. ADO: emails/UPNs or [Project]\Team (added as
# optional). At merge and above the PR is approved and auto-completed right
# away, so named reviewers may never see it.
pr_reviewers=

# Merge method used when auto-merge completes: squash | merge | rebase
pr_merge_method=squash

# Self-approve the PR before arming auto-merge. Best-effort: a host that
# rejects a self-review makes this a no-op, and auto-merge waits for a human
# reviewer instead of failing the ship.
pr_self_approve=true

# How the merge stage waits: poll every pr_poll_interval seconds, up to
# pr_poll_timeout seconds. Past the timeout the ship fails with auto-merge
# still armed. verify_deploy polls at the same interval.
pr_poll_interval=15
pr_poll_timeout=1800

# --- verify_deploy (dev only) ----------------------------------------------------
# ADO pipeline name or ID, or GitHub workflow name, that deploys develop.
deploy_pipeline=
# cloud_run | agent_runtime (agent_engine, its earlier name, also works)
deploy_provider=
# Dev GCP project ID.
deploy_project=
deploy_region=us-central1
# Cloud Run service name, or Agent Runtime display name.
deploy_name=
# How to tell the deploy is this commit: sha | time (default time).
#   sha: the Cloud Run revision is <service>-<sha12> or has a commit=<sha12>
#        label, or the Agent Runtime has a commit=<sha12> label. The deploy has
#        to tag it (a scaffold question).
#   time: the revision or engine was created/updated after the run started.
deploy_match=
# Cloud Run only: smoke-test through `gcloud run services proxy` (for private
# services, where user credentials can't mint an ID token).
deploy_proxy=false
# Smoke test command, run in the ship's worktree with DEPLOY_URL,
# DEPLOY_RESOURCE and DEPLOY_SHA set. Its exit code decides the result, so it
# must fail when it can't reach the target: set its require-live flag.
# e.g. uv run pytest tests/integration
deploy_smoke=
# Seconds to wait for the pipeline run to appear. None means the pipeline's
# path filters excluded the change: the stage is skipped, the ship passes.
deploy_run_grace=300
deploy_poll_timeout=3600
deploy_smoke_timeout=900
